# Copy this file to .env before running Docker Compose.

# PostgreSQL
POSTGRES_USER=armada_dev
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_DB=armada_control
POSTGRES_PORT=5433

# Backend
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d
# Required only for the first owner account; use a random value of 24+ characters.
BOOTSTRAP_TOKEN=replace-with-a-random-owner-bootstrap-token
# Required for subsequent registrations. Use a random value of 16+ characters.
REGISTRATION_INVITE_CODE=replace-with-a-random-registration-invite-code
BACKEND_PORT=4001
CLIENT_ORIGIN=http://localhost:5174
NODE_ENV=development

# Frontend
VITE_API_TARGET=http://backend:4001
FRONTEND_PORT=5174
PREVIEW_PORT=8081
