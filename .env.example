# Copy this file to .env before running Docker Compose.

# PostgreSQL
POSTGRES_USER=armada_dev
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_DB=armada_control
POSTGRES_PORT=5433

# Backend
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d
# Required only for the first owner account; use a random value of 24+ characters.
BOOTSTRAP_TOKEN=mJ5yjcxp046OI5DhFR0Yo8kPzauSf85
# Required for subsequent registrations. Use a random value of 16+ characters.
REGISTRATION_INVITE_CODE=replace-with-a-random-registration-invite-code
BACKEND_PORT=4001
# Host interface yang dipakai untuk expose frontend ke jaringan.
# 127.0.0.1 = hanya localhost (default, aman).
# 0.0.0.0   = bisa diakses dari IP VM / jaringan lain.
HOST_BIND=127.0.0.1
# Harus sesuai dengan URL yang dipakai buka di browser, termasuk port.
# Contoh dari luar VM: http://192.168.1.10:8081
CLIENT_ORIGIN=http://localhost:5174
NODE_ENV=development
# Set "false" hanya jika aplikasi diakses via plain HTTP (bukan HTTPS).
# Cookie CSRF dengan flag secure tidak akan disimpan browser pada http://.
CSRF_SECURE=true

# Frontend
VITE_API_TARGET=http://backend:4001
FRONTEND_PORT=5174
PREVIEW_PORT=8081
