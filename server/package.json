{
  "name": "armada-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Backend API for Armada Control 104 Group (Express + PostgreSQL)",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx --watch src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "migrate": "tsx src/migrations/run.ts",
    "test:report": "tsx scripts/test-report.ts && tsx scripts/check-pdf.mts && tsx scripts/check-xlsx.mts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^7.4.0",
    "jsonwebtoken": "^9.0.2",
    "pdfkit": "^0.17.2",
    "pg": "^8.12.0",
    "tsx": "^4.19.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.2",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "read-excel-file": "^9.3.10",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  }
}
